# 공공데이터포털에서 발급받은 일반 인증키(Decoding)를 입력하세요.
KMA_API_KEY=
KMA_STATION_ID=108
KMA_STATION_NAME=서울

# 공공데이터포털 ASOS 시간자료 전용 인증키(Decoding). 빈 값이면 KMA_API_KEY 사용.
# 전일(D-1)까지의 과거 시간자료 조회용; 오늘 관측/실시간 보정은 API Hub 유지.
KMA_ASOS_HOURLY_API_KEY=
# 공식 조회 주소만 입력하세요. serviceKey 등 쿼리 문자열을 붙이지 마세요.
KMA_HOURLY_URL=https://apis.data.go.kr/1360000/AsosHourlyInfoService/getWthrDataList

# 기상청 API Hub 인증키 (기존 KMA_API_KEY와 별개)
KMA_APIHUB_AUTH_KEY=
# API Hub 시간/일 관측 텍스트 URL. authKey는 URL에서 빼고 위 항목에 입력하세요.
KMA_APIHUB_HOURLY_FILE_URL=
KMA_APIHUB_DAILY_FILE_URL=

MYSQL_ROOT_PASSWORD=weather_root_password
MYSQL_DATABASE=weather_prediction
MYSQL_USER=weather_app
MYSQL_PASSWORD=weather_password
MYSQL_HOST_PORT=3307

